# Copy to .env.local for local dev. In Vercel, set these in Project Settings → Environment Variables.
# Never put secrets in NEXT_PUBLIC_* variables. Never commit .env files.

# Auth.js — generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=
# Google OAuth client (Google Cloud → APIs & Services → Credentials → OAuth client ID, type "Web application")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated admin emails (case-insensitive, exact match)
ADMIN_EMAILS=hr.lead@yourcompany.com,ceo@yourcompany.com

# Google Sheets service account (from the service-account JSON key)
GOOGLE_SHEETS_CLIENT_EMAIL=
# Paste the private_key value with literal \n escapes, wrapped in double quotes
GOOGLE_SHEETS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_ATTEMPTS_TAB=Attempts
GOOGLE_SHEETS_USERS_TAB=Users
GOOGLE_SHEETS_SUMMARY_TAB=Summary
GOOGLE_SHEETS_CONFIG_TAB=Config

# Safety guard: the PRODUCTION spreadsheet ID. Any non-production deployment whose
# GOOGLE_SHEETS_SPREADSHEET_ID equals this refuses to write. Set it in ALL environments.
PRODUCTION_SPREADSHEET_ID=

# Optional: enables the Admin "✦ AI" buttons (server-side proxy, admins only)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
